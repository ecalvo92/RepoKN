@model List<KN_WEB.EF.EstudiantesActividades>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-0">Estudiantes Inscritos</h4>
                        <p class="text-muted mb-0 small">@ViewBag.TituloActividad</p>
                    </div>
                    <a href="@Url.Action("VerActividades", "Actividad")" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-people fs-1 text-muted"></i>
                        <h5 class="mt-3 text-muted">No hay estudiantes inscritos en esta actividad</h5>
                    </div>
                }
                else
                {
                    <table id="TablaEstudiantes" class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Identificación</th>
                                <th>Correo</th>
                                <th>Fecha Inscripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Consecutivo</td>
                                    <td>@item.tbUsuario.Nombre</td>
                                    <td>@item.tbUsuario.Identificacion</td>
                                    <td>@item.tbUsuario.CorreoElectronico</td>
                                    <td>@item.FechaInscripcion.ToString("dd/MM/yyyy hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/verEstudiantesInscritos.js"></script>
}